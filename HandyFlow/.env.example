# Copy to .env.local and use values from ONE Supabase project.
# Browser values are public and bundled at build time. Never put secrets in VITE_*.
VITE_SUPABASE_URL=https://rtaszifelvzbvcbqgrig.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-side values must point to the same project as the browser.
SUPABASE_URL=https://rtaszifelvzbvcbqgrig.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Needed for privileged task actions (cancellations and notifications).
SUPABASE_SERVICE_ROLE_KEY=

# Resend sends application email (invitations, support and Pro requests).
# EMAIL_FROM must use a domain verified in your Resend account.
RESEND_API_KEY=
EMAIL_FROM=HandyFlow <noreply@handyflow.me>

# Configure the same bearer secret in your scheduler for scheduled jobs.
CRON_SECRET=
CRON_SECRET_PREVIOUS=
