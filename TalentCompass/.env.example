# Server-only contact email settings. Never prefix these with VITE_ or NEXT_PUBLIC_.
CONTACT_EMAIL_TO=ivan.teampass@gmail.com
# Use an address on a domain verified in Resend.
CONTACT_EMAIL_FROM=
RESEND_API_KEY=

# Public application origin used in invitation emails (e.g. https://talent.example.com).
APP_URL=

# Server-only Supabase admin key, required to join/create a workspace.
# Use an sb_secret_ key from the same Supabase project.
# Never prefix this variable with VITE_ or NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy fallback for existing deployments (optional).
# SUPABASE_SERVICE_ROLE_KEY=

# Optional server-only AI description generation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
